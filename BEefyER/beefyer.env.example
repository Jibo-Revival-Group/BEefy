BEEFYER_BEEFY_URL=wss://beefy.example.com/beefyer/connect
BEEFYER_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
BEEFYER_RUNTIME_BIN=/opt/BEefyER/runtime/bin/nemo-speech
BEEFYER_RUNTIME_URL=ws://127.0.0.1:8089/v1/audio/transcriptions/realtime
# Indexed English Nemotron Speech Streaming 0.6B Q8_0; a local GGUF path is also accepted.
BEEFYER_MODEL=nemotron-en
BEEFYER_THREADS=4
BEEFYER_CAPACITY=1
BEEFYER_QUEUE_CAPACITY=32
BEEFYER_FINAL_TIMEOUT=3
