BEEFYER_BEEFY_URL=wss://beefy.example.com/beefyer/connect
BEEFYER_SHARED_SECRET=REPLACE_WITH_GENERATED_SECRET
BEEFYER_RUNTIME_BIN=/opt/BEefyER/runtime/bin/nemo-speech
BEEFYER_RUNTIME_URL=ws://127.0.0.1:8089/v1/audio/transcriptions/realtime
# auto prefers prepared models/nemotron-en-f16.gguf, otherwise the indexed English Q8 model.
BEEFYER_MODEL=auto
# 0 = hardware-aware auto (up to eight inference threads). Explicit values override auto.
BEEFYER_THREADS=0
# 6 = accuracy-focused 560 ms streaming; 1 = faster 160 ms streaming.
BEEFYER_RIGHT_CONTEXT=6
BEEFYER_HOTWORDS='["Jibo", "Hey Jibo"]'
BEEFYER_HOTWORD_BOOST=2.5
BEEFYER_CAPACITY=1
BEEFYER_QUEUE_CAPACITY=32
BEEFYER_FINAL_TIMEOUT=3
BEEFYER_VAD_ENABLED=true
BEEFYER_VAD_MODEL=/opt/BEefyER/models/silero-v6.2.1.onnx
BEEFYER_VAD_SILENCE_MS=320
