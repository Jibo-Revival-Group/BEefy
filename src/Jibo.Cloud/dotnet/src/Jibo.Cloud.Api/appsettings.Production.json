{
  "OpenJibo": {
    "Deployment": {
      "Mode": "managed"
    },
    "Logging": {
      "MinimumLevel": "Information",
      "DirectoryPath": "captures/logs",
      "FileName": "openjibo-.log",
      "ResetOnStartup": false
    },
    "FleetNetwork": {
      "PeerSyncEnabled": false,
      "AllowedPeerHosts": ""
    },
    "Telemetry": {
      "Enabled": true,
      "ExportFixtures": false,
      "DirectoryPath": "captures/websocket",
      "RetentionDays": 7,
      "MaxDirectoryBytes": 524288000
    },
    "ProtocolTelemetry": {
      "Enabled": true,
      "DirectoryPath": "captures/http",
      "RetentionDays": 7,
      "MaxDirectoryBytes": 524288000
    },
    "TurnTelemetry": {
      "Enabled": true,
      "DirectoryPath": "captures/turn",
      "RetentionDays": 7,
      "MaxDirectoryBytes": 524288000
    },
    "State": {
      "Backend": "Sqlite",
      "PersistencePath": "/var/lib/5x1/cloud-state.json"
    },
    "PersonalMemory": {
      "Backend": "Sqlite",
      "PersistencePath": "/var/lib/5x1/personal-memory.json"
    },
    "CanonicalApiHostname": "api.5x1.com",
    "Stt": {
      "EnableLocalWhisperCpp": true,
      "EnableAzureSpeech": false,
      "EnableWhisperServer": true,
      "EnableStreamingSherpa": false,
      "AutoStartWhisperServer": true,
      "FfmpegPath": "/usr/bin/ffmpeg",
      "WhisperCliPath": "/usr/bin/whisper.cpp/build/bin/whisper-cli",
      "WhisperModelPath": "/usr/bin/whisper.cpp/models/ggml-base.en.bin",
      "WhisperServerUrl": "http://127.0.0.1:8090",
      "WhisperLanguage": "en",
      "WhisperAudioContext": 512,
      "WhisperThreads": 0,
      "WhisperBeamSize": 1,
      "TempDirectory": "/tmp/openjibo-stt",
      "CleanupTempFiles": true
    },
    "Listen": {
      "EnableModelEndpointing": false,
      "Rule1MinTrailingSilenceSeconds": 0.4,
      "Rule2MinTrailingSilenceSeconds": 0.6,
      "DefaultMaxUtteranceSeconds": 20
    },
    "Weather": {
      "OpenWeather": {
        "BaseUrl": "https://api.openweathermap.org",
        "DefaultLocation": "Boston,US",
        "UseCelsius": false,
        "CurrentCacheTtlSeconds": 120,
        "ForecastCacheTtlSeconds": 600,
        "GeocodeCacheTtlSeconds": 21600,
        "FailureCacheTtlSeconds": 45
      }
    },
    "FunFacts": {
      "UselessFacts": {
        "BaseUrl": "https://uselessfacts.jsph.pl",
        "FailureCacheTtlSeconds": 45
      }
    },
    "Dictionary": {
      "FreeDictionaryApi": {
        "BaseUrl": "https://freedictionaryapi.com",
        "FailureCacheTtlSeconds": 45,
        "SuccessCacheTtlSeconds": 300
      }
    },
    "Wikipedia": {
      "ApiBaseUrl": "https://en.wikipedia.org/w/api.php",
      "RestBaseUrl": "https://en.wikipedia.org/api/rest_v1",
      "OpenSearchLimit": 5,
      "FailureCacheTtlSeconds": 45,
      "SuccessCacheTtlSeconds": 300
    },
    "News": {
      "NewsApi": {
        "BaseUrl": "https://newsapi.org",
        "Country": "us",
        "Language": "en",
        "FallbackQuery": "robotics OR technology OR science",
        "DefaultCategories": [ "general", "technology", "sports", "business" ],
        "CacheTtlSeconds": 300,
        "FailureCacheTtlSeconds": 45
      }
    },
    "Search": {
      "Primary": "none",
      "Fallback": null,
      "CacheTtlSeconds": 300,
      "FailureCacheTtlSeconds": 45
    }
  }
}
